# DeepJudge upstream credentials
DEEPJUDGE_API_KEY=
DEEPJUDGE_SEARCH_URL=https://api.deepjudge.ai/v1/search
DEEPJUDGE_API_KEY_HEADER=Authorization
DEEPJUDGE_TIMEOUT_SECONDS=30

# Protect your public mobile API. Generate a long random value.
MOBILE_API_TOKEN=

# Set this to your app's origin if browser clients will call the API.
MOBILE_API_ALLOW_ORIGIN=*

# Server settings
HOST=0.0.0.0
PORT=8000

# Optional when terminating TLS directly in Python. Most cloud deployments
# should terminate HTTPS at the platform/proxy instead.
# TLS_CERTFILE=
# TLS_KEYFILE=
